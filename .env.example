# FastAPI local configuration
# The platform runs a single administrator session; local HTTP development
# must opt out of the secure cookie default explicitly.
SESSION_COOKIE_SECURE=false

# AI runtime: the Worker is production/real-AI by default.
# OpenAI official or any OpenAI Chat Completions-compatible vendor:
AI_RUNTIME_MODE=production
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# OpenAI wire protocol (AI_PROVIDER=openai only), explicit deployment choice —
# never an automatic fallback after a failed request:
#   responses          (default) native Responses API; reasoning effort is sent
#                      as reasoning.effort; multi-turn tool history is
#                      client-held (store=false, encrypted reasoning
#                      round-trips, no previous_response_id). REQUIRED for
#                      current OpenAI reasoning models that combine function
#                      tools with a reasoning effort (e.g. gpt-5.6-luna +
#                      medium: Chat Completions rejects that with HTTP 400).
#   chat_completions   only for gateways that expose just the Chat Completions
#                      contract; effort is sent as top-level reasoning_effort.
AI_OPENAI_API=responses
# OpenAI reasoning models only; leave empty for the model default (distinct
# from an explicit none, which IS sent) or when using Anthropic/non-reasoning
# models. Values depend on the model/gateway:
# none, minimal, low, medium, high, xhigh, max. Example: medium.
AI_REASONING_EFFORT=
AI_API_KEY=replace-with-provider-api-key
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MODEL_RETRIES=1
# Leave empty for the official OpenAI endpoint. For a compatible vendor, use
# its OpenAI Chat Completions base URL (for example, https://host.example/v1).
AI_BASE_URL=
# To use Anthropic instead, set:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# AI_API_KEY=replace-with-anthropic-api-key
# Anthropic-compatible endpoint root; the SDK appends /v1/messages.
# AI_BASE_URL=https://host.example

# Business database. PostgreSQL is the production choice; the local SQLite
# default (backend/storage/blue-benchmark.db) is fine for development and is the
# only mode the fake Worker supports.
DATABASE_URL=postgresql+psycopg://blue_benchmark:change-me@127.0.0.1:5432/blue_benchmark

# Durable deep-agent runtime (rubric generation continuity).
# Dedicated PostgreSQL database for LangGraph checkpoints on the same Docker
# instance as the business database. Prepared explicitly (saver.setup()),
# never on page load. psycopg DSN form (no +psycopg suffix).
CHECKPOINT_DATABASE_URL=postgresql://blue_benchmark_checkpoint:change-me@127.0.0.1:5432/blue_benchmark_checkpoint
# AES key for the encrypted checkpoint serializer; must be 16, 24 or 32 bytes.
# Generate once (e.g. `openssl rand -hex 16` for 32 hex chars) and never
# rotate casually: existing checkpoints become unreadable without it.
LANGGRAPH_AES_KEY=replace-with-32-byte-aes-key

# Operation Worker tuning
OPERATION_LEASE_SECONDS=60
OPERATION_MAX_ATTEMPTS=3

# Set false to skip the Alembic head check on API startup (tests only).
DATABASE_SCHEMA_CHECK_ON_STARTUP=true

# Single admin account (sole authority). The API seeds it into the users table
# on startup and overwrites the stored credentials whenever these values
# change, so switching the password = edit here + restart. Placeholders only:
# real values belong in the gitignored .env, never in this committed template.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
