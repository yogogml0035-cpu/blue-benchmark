# FastAPI local configuration
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
UPLOAD_MAX_BYTES=1048576
UPLOAD_MAX_FILES=50
UPLOAD_MAX_TOTAL_BYTES=10485760
ARCHIVE_MAX_MEMBERS=50
ARCHIVE_MAX_UNCOMPRESSED_BYTES=20971520
ARCHIVE_MAX_DEPTH=1
ARCHIVE_MAX_RATIO=100

# PostgreSQL business database (use the local SQLite default only for tests)
DATABASE_URL=postgresql+psycopg://skill_eval:change-me@127.0.0.1:5432/skill_eval
# Kept separate from DATABASE_URL for the future encrypted Checkpointer.
CHECKPOINT_DATABASE_URL=postgresql+psycopg://skill_eval_checkpoint:change-me@127.0.0.1:5432/skill_eval
CHECKPOINT_AES_KEY=replace-with-16-24-or-32-byte-secret
STORAGE_ROOT=./storage
OPERATION_LEASE_SECONDS=60
OPERATION_MAX_ATTEMPTS=3

# Next.js Rewrite target
BACKEND_URL=http://127.0.0.1:8000
