# Skill Eval Platform 生产环境变量模板
#
# 用法：复制到服务器 /opt/skill-eval/.env，填入真实值后执行
#   chmod 600 .env
# 此文件包含密钥，绝不能提交到仓库或分享给他人。

# --- 镜像来源（ACR 地址与版本标签，docker compose 会读取） ---
# 形如 registry.cn-beijing.aliyuncs.com/<命名空间>
REGISTRY=
# 镜像版本标签，格式 YYYYMMDD-<git短哈希>，由 deploy/push-images.sh 生成
TAG=

# --- HTTP 部署（裸 IP 首版必须为 false；启用 HTTPS 后改回 true） ---
SESSION_COOKIE_SECURE=false

# --- 业务数据库（主机名固定为 postgres，即 compose 服务名） ---
POSTGRES_USER=skill_eval
POSTGRES_PASSWORD=换成一个随机强密码
POSTGRES_DB=skill_eval
DATABASE_URL=postgresql+psycopg://skill_eval:换成同一个随机强密码@postgres:5432/skill_eval

# --- 启动时检查数据库迁移状态 ---
DATABASE_SCHEMA_CHECK_ON_STARTUP=true

# --- 真实 AI（照抄你本地开发 .env 里的这一组值） ---
AI_RUNTIME_MODE=production
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MODEL_RETRIES=1

# --- Worker 调优（保持默认即可） ---
OPERATION_LEASE_SECONDS=60
OPERATION_MAX_ATTEMPTS=3
