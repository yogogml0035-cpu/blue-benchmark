# Skill Eval Platform 生产环境变量模板
#
# 用法：复制到服务器 /opt/skill-eval/.env，填入真实值后执行
#   chmod 600 .env
# 此文件包含密钥，绝不能提交到仓库或分享给他人。

# --- 镜像来源（ACR 地址与版本标签，docker compose 会读取） ---
# 形如 registry.cn-beijing.aliyuncs.com/<命名空间>
REGISTRY=
# 镜像版本标签，格式 YYYYMMDD-<git短哈希>，由 deploy/push-images.sh 生成
TAG=

# --- HTTP 部署（裸 IP 首版必须为 false；启用 HTTPS 后改回 true） ---
SESSION_COOKIE_SECURE=false

# --- 业务数据库（主机名固定为 postgres，即 compose 服务名） ---
POSTGRES_USER=skill_eval
POSTGRES_PASSWORD=换成一个随机强密码
POSTGRES_DB=skill_eval
DATABASE_URL=postgresql+psycopg://skill_eval:换成同一个随机强密码@postgres:5432/skill_eval

# --- 持久 Agent 运行时（维度生成链路的 checkpoint 库与加密密钥） ---
# checkpoint 是独立数据库，发版前需在服务器 postgres 里创建一次：
#   docker compose exec postgres createdb -U skill_eval skill_eval_checkpoint
# 库内表结构由应用在首次真实生成时自动建立；密码与 POSTGRES_PASSWORD 相同。
# 注意协议前缀是 postgresql://（不带 +psycopg，此处不走 SQLAlchemy）
CHECKPOINT_DATABASE_URL=postgresql://skill_eval:换成同一个随机强密码@postgres:5432/skill_eval_checkpoint
# 32 字节随机密钥，用 openssl rand -hex 16 生成；启用后不可更换，
# 更换会导致已有 checkpoint 无法解密
LANGGRAPH_AES_KEY=用 openssl rand -hex 16 生成

# --- 启动时检查数据库迁移状态 ---
DATABASE_SCHEMA_CHECK_ON_STARTUP=true

# --- 真实 AI（照抄你本地开发 .env 里的这一组值） ---
AI_RUNTIME_MODE=production
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MODEL_RETRIES=1

# --- Worker 调优（保持默认即可） ---
OPERATION_LEASE_SECONDS=60
OPERATION_MAX_ATTEMPTS=3

# --- OSS 异地备份副本（backup.py run 在服务恢复后上传，只留最新一套） ---
# 三项都不含密钥：OSS 的 AccessKey 凭证由服务器上的 ossutil 自身配置管理
# （ossutil config，建议 RAM 子账号只授予该桶专用前缀的读写权限），
# 绝不能把 AccessKey 写进本文件或提交到仓库。
# 专用备份桶名（私有读写；不要与网站静态资源等其他业务共用）
OSS_BUCKET=换成你的私有备份桶名
# 桶内专用备份前缀（不能是桶根目录；工具只管理该前缀内的对象）
OSS_PREFIX=skill-eval-backups
# 与服务器同地域的内网 Endpoint（形如 oss-cn-beijing-internal.aliyuncs.com）：
# 同地域内网访问不收流量费；备份上传与发布前回读校验都走该地址。
# Mac 公网恢复下载不使用此配置（见恢复指引）。
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
